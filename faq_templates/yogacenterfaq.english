{
  "faqs": [
    {
      "category": "membership_overview",
      "question": "What is a yoga center membership?",
      "answer": "A yoga center membership is a plan that allows you to attend yoga classes regularly for a fixed period such as monthly, quarterly, or yearly."
    },
    {
      "category": "enrollment_process",
      "question": "How can I enroll in a yoga center membership?",
      "answer": "You can enroll by visiting the yoga center, registering online, or contacting the center through phone or email."
    },
    {
      "category": "membership_types",
      "question": "What types of membership plans are available?",
      "answer": "Most yoga centers offer monthly, quarterly, half-yearly, and yearly membership plans depending on your preference."
    },
    {
      "category": "trial_classes",
      "question": "Do you offer trial yoga classes before enrollment?",
      "answer": "Yes, many yoga centers offer free or paid trial classes before you choose a membership plan."
    },
    {
      "category": "membership_fees",
      "question": "How much does a yoga membership cost?",
      "answer": "Membership fees vary based on duration, class type, and center facilities. Exact pricing is provided during enrollment."
    },
    {
      "category": "class_access",
      "question": "Can I attend any class with my membership?",
      "answer": "It depends on your membership plan. Some plans allow unlimited access while others restrict specific classes or timings."
    },
    {
      "category": "registration_documents",
      "question": "What documents are required for enrollment?",
      "answer": "Usually, a valid ID proof, contact details, and basic health information are required for registration."
    },
    {
      "category": "batch_timing",
      "question": "Can I choose my yoga class timings?",
      "answer": "Yes, you can choose from available batches such as morning, evening, or weekend sessions depending on availability."
    },
    {
      "category": "membership_freeze",
      "question": "Can I pause or freeze my membership?",
      "answer": "Yes, many yoga centers allow you to pause your membership for a certain period due to travel or health reasons."
    },
    {
      "category": "refund_policy",
      "question": "Is membership fee refundable?",
      "answer": "Refund policies vary by center. Some offer partial refunds while others may not provide refunds after enrollment."
    },
    {
      "category": "renewal",
      "question": "How do I renew my membership?",
      "answer": "You can renew your membership online or at the center before your current plan expires."
    },
    {
      "category": "discounts_offers",
      "question": "Are there discounts for long-term membership?",
      "answer": "Yes, most yoga centers provide discounts for quarterly, half-yearly, or yearly memberships."
    },
    {
      "category": "family_membership",
      "question": "Do you offer family or group membership plans?",
      "answer": "Yes, some yoga centers offer special discounts for family or group enrollment."
    },
    {
      "category": "attendance_tracking",
      "question": "How is attendance tracked in yoga classes?",
      "answer": "Attendance is usually tracked digitally or manually at the reception before each class."
    },
    {
      "category": "membership_support",
      "question": "Who can I contact for membership-related queries?",
      "answer": "You can contact the yoga center receptionist or support team for any membership or enrollment assistance."
    }
  ]
}
