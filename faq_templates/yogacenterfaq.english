  "faqs": [
    {
      "category": "health_condition_overview",
      "question": "What health conditions can yoga help with?",
      "answer": "Yoga can help improve flexibility, reduce stress, support weight management, and manage conditions like back pain, hypertension, and anxiety."
    },
    {
      "category": "back_pain",
