{
  "faqs": [
    {
      "category": "yoga_overview",
      "question": "What is beginner yoga?",
      "answer": "Beginner yoga is a simple form of yoga designed for new learners, focusing on basic poses, breathing techniques, and flexibility."
    },
    {
      "category": "who_can_join",
      "question": "Can beginners join yoga classes?",
      "answer": "Yes, yoga classes are suitable for beginners of all ages and fitness levels."
    },
    {
      "category": "first_class",
      "question": "What should I expect in my first yoga class?",
      "answer": "In your first class, you will learn basic poses, breathing exercises, and simple stretching techniques in a calm environment."
    },
    {
      "category": "equipment_needed",
      "question": "Do I need any equipment for yoga?",
      "answer": "A yoga mat and comfortable clothing are usually enough for beginner yoga classes."
    },
    {
      "category": "physical_fitness",
      "question": "Do I need to be fit to start yoga?",
      "answer": "No, yoga is for everyone. Beginners can start at their own pace and gradually improve flexibility and strength."
    },
    {
      "category": "health_benefits",
      "question": "What are the benefits of beginner yoga?",
      "answer": "Yoga improves flexibility, reduces stress, enhances focus, and helps in overall physical and mental well-being."
    },
    {
      "category": "difficulty_level",
      "question": "Is beginner yoga difficult?",
      "answer": "No, beginner yoga is gentle and easy to follow, with simple poses and slow movements."
    },
    {
      "category": "session_duration",
      "question": "How long is a yoga class?",
      "answer": "Most beginner yoga sessions last between 45 minutes to 1 hour."
    },
    {
      "category": "frequency",
      "question": "How often should I attend yoga classes?",
      "answer": "It is recommended to attend 2 to 4 classes per week for better results."
    },
    {
      "category": "injury_safety",
      "question": "Is yoga safe for beginners with injuries?",
      "answer": "Yes, but you should inform the instructor so they can modify poses according to your condition."
    },
    {
      "category": "weight_loss",
      "question": "Can yoga help with weight loss?",
      "answer": "Yes, regular yoga practice can support weight management along with a healthy lifestyle."
    },
    {
      "category": "stress_relief",
      "question": "Does yoga help reduce stress?",
      "answer": "Yes, yoga includes breathing and meditation techniques that help reduce stress and improve relaxation."
    },
    {
      "category": "age_limit",
      "question": "Is there any age limit for yoga classes?",
      "answer": "No, yoga is suitable for children, adults, and seniors with appropriate modifications."
    },
    {
      "category": "clothing",
      "question": "What should I wear for yoga?",
      "answer": "Wear comfortable, stretchable clothing that allows easy movement during practice."
    },
    {
      "category": "progress_time",
      "question": "How long does it take to see results from yoga?",
      "answer": "With regular practice, noticeable improvements can be seen in a few weeks to a few months."
    }
  ]
}
{
  "faqs": [
    {
      "category": "yoga_overview",
      "question": "What is yoga?",
      "answer": "Yoga is a practice that combines physical postures, breathing exercises, and meditation to improve physical and mental well-being."
    },
    {
      "category": "hatha_yoga",
      "question": "What is Hatha Yoga?",
      "answer": "Hatha Yoga focuses on basic postures and breathing techniques, making it suitable for beginners."
    },
    {
      "category": "ashtanga_yoga",
      "question": "What is Ashtanga Yoga?",
      "answer": "Ashtanga Yoga is a dynamic and structured style that involves a fixed sequence of postures performed in a continuous flow."
    },
    {
      "category": "vinyasa_yoga",
      "question": "What is Vinyasa Yoga?",
      "answer": "Vinyasa Yoga links breath with movement and creates a flowing sequence of poses, often more fast-paced."
    },
    {
      "category": "iyengar_yoga",
      "question": "What is Iyengar Yoga?",
      "answer": "Iyengar Yoga focuses on precise alignment and often uses props like blocks and straps to support poses."
    },
    {
      "category": "kundalini_yoga",
      "question": "What is Kundalini Yoga?",
      "answer": "Kundalini Yoga combines breathing, chanting, and postures to awaken energy and improve spiritual awareness."
    },
    {
      "category": "power_yoga",
      "question": "What is Power Yoga?",
      "answer": "Power Yoga is a fitness-based yoga style that focuses on strength, flexibility, and endurance."
    },
    {
      "category": "yin_yoga",
      "question": "What is Yin Yoga?",
      "answer": "Yin Yoga involves holding poses for longer durations to deeply stretch connective tissues and improve flexibility."
    },
    {
      "category": "restorative_yoga",
      "question": "What is Restorative Yoga?",
      "answer": "Restorative Yoga focuses on relaxation and stress relief using gentle poses and supportive props."
    },
    {
      "category": "prenatal_yoga",
      "question": "What is Prenatal Yoga?",
      "answer": "Prenatal Yoga is designed for pregnant women to improve flexibility, reduce stress, and prepare for childbirth."
    },
    {
      "category": "beginner_yoga",
      "question": "Which yoga is best for beginners?",
      "answer": "Hatha Yoga and gentle Vinyasa Yoga are best for beginners due to their simple and slow-paced nature."
    },
    {
      "category": "weight_loss_yoga",
      "question": "Which yoga is good for weight loss?",
      "answer": "Power Yoga, Ashtanga Yoga, and Vinyasa Yoga are effective for weight loss and fitness."
    },
    {
      "category": "stress_relief_yoga",
      "question": "Which yoga is best for stress relief?",
      "answer": "Restorative Yoga, Yin Yoga, and meditation-based practices are best for stress relief."
    },
    {
      "category": "yoga_for_flexibility",
      "question": "Which yoga improves flexibility?",
      "answer": "Yin Yoga and Hatha Yoga are excellent for improving flexibility over time."
    },
    {
      "category": "yoga_selection",
      "question": "How do I choose the right type of yoga?",
      "answer": "The right yoga depends on your goals such as fitness, relaxation, flexibility, or spiritual growth. A yoga instructor can help you decide."
    }
  ]
}
